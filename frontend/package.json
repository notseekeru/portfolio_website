{
    "name": "portfolio-frontend",
    "private": true,
    "version": "2.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "sh scripts/check-tokens.sh src && tsc --noEmit -p tsconfig.json && vite build",
        "check-tokens": "sh scripts/check-tokens.sh src",
        "typecheck": "tsc --noEmit -p tsconfig.json",
        "lint": "biome check . --fix --unsafe",
        "preview": "vite preview"
    },
    "dependencies": {
        "@types/unist": "3.0.3",
        "mermaid": "12.3.0",
        "motion": "14.14.0",
        "prismjs": "1.30.0",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-icons": "5.7.0",
        "react-router-dom": "7.18.7",
        "react-zoom-pan-pinch": "4.4.0",
        "rehype-sanitize": "6.0.0",
        "rehype-stringify": "10.0.1",
        "remark-gfm": "4.0.1",
        "remark-parse": "11.0.0",
        "remark-rehype": "11.1.2",
        "unified": "11.0.5",
        "unist-util-visit": "5.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.9",
        "@tailwindcss/postcss": "4.3.5",
        "@types/node": "26.6.7",
        "@types/prismjs": "1.26.6",
        "@types/react": "19.3.1",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "postcss": "8.5.33",
        "tailwindcss": "4.3.5",
        "typescript": "7.0.2",
        "vite": "8.3.8"
    },
    "overrides": {
        "uuid": "14.0.3"
    }
